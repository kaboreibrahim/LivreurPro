# ══════════════════════════════════════════════
#  LivreurPro — Exemple de configuration
#  Copiez ce fichier en .env et remplissez les valeurs
# ══════════════════════════════════════════════

# ── Django ────────────────────────────────────
SECRET_KEY=votre-secret-key-ici
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de données (LOCAL - PostgreSQL) ──────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=LivreurPro
DB_USER=postgres
DB_PASSWORD=votre-mot-de-passe
DB_HOST=localhost
DB_PORT=5432

# ── Base de données (PRODUCTION - MySQL cPanel) ──
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=c2712705c_LivreurPro
# DB_USER=c2712705c_admin
# DB_PASSWORD=votre-mot-de-passe
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ── Email (Gmail SMTP) ────────────────────────
EMAIL_HOST_USER=votre@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application

# ── Mapbox ────────────────────────────────────
MAPBOX_ACCESS_TOKEN=pk.votre-token-mapbox

# ── LocationIQ (autocomplétion adresses) ──────
LOCATIONIQ_KEY=pk.votre-cle-locationiq
